# Copy this file to .env and fill in real values. Never commit .env itself.

PORT=3000

# SQLite file path - keep this on a persistent disk path once deployed,
# not inside a container's ephemeral layer.
DATABASE_URL="file:./dev.db"

# Signs admin/manager login tokens. Generate a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# One-time setup: used by `npm run seed` to create your first admin login.
# Not read anywhere else after that.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# WhatsApp (Meta Cloud API) - filled in once the Meta app is created (Stage 2)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# The customer-facing number used to build wa.me links, digits only, no "+".
WHATSAPP_DISPLAY_NUMBER=

# Dev-only escape hatch so you can POST fake webhook payloads with curl
# before a real WHATSAPP_APP_SECRET exists. Must stay unset in production -
# leaving it set would let anyone spoof WhatsApp webhook calls.
WHATSAPP_SKIP_SIGNATURE_VERIFICATION=false

# Base URL this backend is reachable at, used to build QR redirect links
# and the printable QR images.
PUBLIC_BASE_URL="http://localhost:3000"
